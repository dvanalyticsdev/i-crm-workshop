<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>7 Days Gen AI & Agentic AI Hands-on Master Program | DV Analytics</title>
  <link rel="icon" type="image/png" href="Logos/DV-Logo.png" />
  <script src="theme-bootstrap.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
  <style>
    :root {
      --primary-orange: #ef5323;
      --primary-orange-rgb: 239, 83, 35;
      --orange-glow: rgba(239, 83, 35, 0.15);
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --text-primary: #051f40;
      --text-secondary: #64748b;
      --text-muted: #94a3b8;
      --border-color: #e2e8f0;
      --card-bg: #ffffff;
      --font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body.crash-course-body {
      font-family: var(--font-family);
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.6;
    }

    .cc-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Header Nav */
    .cc-header {
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border-color);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.85);
    }

    .cc-header-wrap {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cc-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .cc-logo img {
      height: 48px;
      width: auto;
      object-fit: contain;
      transition: transform 0.25s ease;
    }
    
    .cc-logo img:hover {
      transform: scale(1.02);
    }

    .cc-nav-btn {
      background: linear-gradient(135deg, var(--primary-orange), #ff6b43);
      color: #fff;
      border: none;
      padding: 0.65rem 1.5rem;
      border-radius: 30px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      box-shadow: 0 4px 15px var(--orange-glow);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cc-nav-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(239, 83, 35, 0.3);
    }

    /* Hero Section */
    .cc-hero {
      background: linear-gradient(135deg, #051f40 0%, #090d16 100%);
      padding: 5rem 0 6.5rem;
      text-align: center;
      position: relative;
      color: #ffffff;
    }

    .cc-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #f87e59;
      padding: 0.4rem 1.15rem;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 2rem;
      letter-spacing: 0.5px;
    }

    .cc-hero h1 {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 800;
      line-height: 1.12;
      margin-bottom: 1.5rem;
      color: #ffffff;
      letter-spacing: -1px;
    }

    .cc-hero h1 span {
      background: linear-gradient(135deg, var(--primary-orange), #ff9a76);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .cc-hero p.tagline {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: #cbd5e1;
      max-width: 800px;
      margin: 0 auto 2.5rem;
      line-height: 1.6;
      font-weight: 300;
    }

    .cc-hero-actions {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .btn-main-enroll {
      background: linear-gradient(135deg, var(--primary-orange), #ff6b43);
      color: #ffffff;
      border: none;
      padding: 0.85rem 2.25rem;
      font-size: 1rem;
      font-weight: 700;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 4px 15px var(--orange-glow);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-main-enroll:hover {
      transform: scale(1.02) translateY(-2px);
      box-shadow: 0 6px 20px rgba(239, 83, 35, 0.35);
    }

    .btn-syllabus-download {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #e2e8f0;
      padding: 0.85rem 2rem;
      font-size: 1rem;
      font-weight: 700;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-syllabus-download:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.25);
      color: #ffffff;
      transform: translateY(-2px);
    }

    /* Stats Grid Sitting on the Transition */
    .course-stats-section {
      position: relative;
      margin-top: -40px;
      z-index: 10;
    }

    .cc-hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    @media (max-width: 768px) {
      .cc-hero-stats {
        grid-template-columns: 1fr;
      }
      .course-stats-section {
        margin-top: -20px;
      }
    }

    .cc-stat-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      padding: 1.5rem 1.75rem;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 30px rgba(5, 31, 64, 0.04);
      transition: all 0.3s ease;
    }

    .cc-stat-card:hover {
      border-color: rgba(239, 83, 35, 0.2);
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(5, 31, 64, 0.08);
    }

    .cc-stat-val {
      font-size: 1.75rem;
      font-weight: 800;
      color: #ef5323;
      margin-bottom: 0.25rem;
    }

    .cc-stat-label {
      color: #64748b;
      font-size: 0.88rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Sections Shared styling */
    .cc-section {
      padding: 6rem 0;
    }

    .cc-section-title {
      text-align: center;
      margin-bottom: 4rem;
    }

    .cc-section-title h2 {
      font-size: 2rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 0.75rem;
      letter-spacing: -0.5px;
      position: relative;
      display: inline-block;
    }
    
    .cc-section-title h2::after {
      content: '';
      display: block;
      width: 50px;
      height: 4px;
      background-color: var(--primary-orange);
      margin: 0.5rem auto 0;
      border-radius: 2px;
    }

    .cc-section-title h2 span {
      color: var(--primary-orange);
    }

    .cc-section-title p {
      color: #64748b;
      font-size: 1.05rem;
      font-weight: 500;
    }

    /* Program Highlights */
    .highlights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .highlight-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      padding: 2.25rem 2rem;
      border-radius: 20px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .highlight-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--primary-orange);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .highlight-card:hover {
      border-color: rgba(239, 83, 35, 0.2);
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(5, 31, 64, 0.06);
    }

    .highlight-card:hover::before {
      opacity: 1;
    }

    .highlight-icon {
      width: 52px;
      height: 52px;
      background: rgba(239, 83, 35, 0.08);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary-orange);
      font-size: 1.5rem;
      margin-bottom: 1.25rem;
    }

    .highlight-card h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 0.5rem;
    }

    .highlight-card p {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Curriculum Accordion */
    .curriculum-wrap {
      max-width: 950px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .day-accordion {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
      transition: all 0.3s ease;
    }

    .day-accordion.active {
      box-shadow: 0 10px 30px rgba(5, 31, 64, 0.05);
      border-color: rgba(239, 83, 35, 0.25);
    }

    .day-trigger {
      width: 100%;
      background: #ffffff;
      border: none;
      padding: 1.75rem 2.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      text-align: left;
      transition: background-color 0.3s ease;
    }

    .day-trigger:hover {
      background-color: #fafafa;
    }

    .day-info {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .day-num {
      background: var(--primary-orange);
      color: #fff;
      font-weight: 800;
      padding: 0.4rem 1rem;
      border-radius: 50px;
      font-size: 0.8rem;
      letter-spacing: 0.5px;
    }

    .day-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: #051f40;
    }

    .day-toggle-icon {
      color: #64748b;
      font-size: 1.5rem;
      font-weight: 300;
      transition: transform 0.3s ease;
    }

    .day-accordion.active .day-toggle-icon {
      transform: rotate(45deg);
      color: var(--primary-orange);
    }

    .day-content {
      display: none;
      padding: 0 2.25rem 2.25rem 2.25rem;
      border-top: 1px solid #f1f5f9;
      background: #ffffff;
    }

    .day-summary-text {
      color: #ef5323;
      font-weight: 700;
      font-size: 0.95rem;
      margin: 1.5rem 0 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .day-topics {
      list-style: none;
      padding-left: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 0.75rem;
    }

    .day-topics li {
      position: relative;
      padding-left: 1.5rem;
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .day-topics li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--primary-orange);
      font-weight: 800;
      font-size: 0.9rem;
    }

    /* Projects Section */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .project-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 2.25rem 2rem;
      transition: all 0.3s ease;
      position: relative;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .project-card:hover {
      border-color: rgba(239, 83, 35, 0.2);
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(5, 31, 64, 0.06);
    }

    .project-badge {
      background: rgba(239, 83, 35, 0.08);
      border: 1px solid rgba(239, 83, 35, 0.2);
      color: #ef5323;
      padding: 0.35rem 0.85rem;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      display: inline-block;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
    }

    .project-card h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 0.75rem;
    }

    .project-card p {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Outcomes Section */
    .outcomes-box {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: 3rem;
      box-shadow: 0 10px 30px rgba(5, 31, 64, 0.03);
      position: relative;
    }

    .outcomes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
    }

    .outcomes-col h3 {
      font-size: 1.35rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 0.75rem;
    }

    .outcomes-col h3 span {
      color: var(--primary-orange);
    }

    .outcomes-list {
      list-style: none;
      padding-left: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .outcomes-list li {
      position: relative;
      padding-left: 1.75rem;
      color: #64748b;
      font-size: 0.98rem;
      line-height: 1.5;
    }

    .outcomes-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--primary-orange);
      font-weight: 800;
      font-size: 1rem;
    }

    /* Enrollment Modal styling */
    .cc-modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(5, 31, 64, 0.5);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .cc-modal.active {
      opacity: 1;
      pointer-events: auto;
    }

    .cc-modal-box {
      background: #ffffff;
      border: 1px solid var(--border-color);
      max-width: 500px;
      width: 100%;
      border-radius: 24px;
      padding: 2.5rem;
      box-shadow: 0 20px 50px rgba(5, 31, 64, 0.12);
      position: relative;
      transform: translateY(20px);
      transition: transform 0.3s ease;
    }

    .cc-modal.active .cc-modal-box {
      transform: translateY(0);
    }

    .cc-modal-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background: rgba(5, 31, 64, 0.05);
      border: none;
      color: #64748b;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1.2rem;
      transition: all 0.2s ease;
    }

    .cc-modal-close:hover {
      background: rgba(239, 83, 35, 0.1);
      color: var(--primary-orange);
    }

    .cc-modal h3 {
      font-size: 1.65rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 0.5rem;
    }

    .cc-modal p.intro-text {
      color: #64748b;
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .cc-form-group {
      margin-bottom: 1.25rem;
    }

    .cc-form-group label {
      display: block;
      color: #051f40;
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .cc-form-group input, .cc-form-group select {
      width: 100%;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      color: #051f40;
      padding: 0.85rem 1rem;
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s ease;
      box-sizing: border-box;
    }

    .cc-form-group input:focus, .cc-form-group select:focus {
      border-color: var(--primary-orange);
    }

    .cc-form-group select option {
      background: #ffffff;
      color: #051f40;
    }

    .cc-modal-submit-btn {
      width: 100%;
      background: linear-gradient(135deg, var(--primary-orange), #ff6b43);
      color: #fff;
      border: none;
      padding: 0.9rem;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 15px var(--orange-glow);
      transition: all 0.3s ease;
      margin-top: 1rem;
    }

    .cc-modal-submit-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(239, 83, 35, 0.3);
    }

    .cc-modal-submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .cc-alert {
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      display: none;
      line-height: 1.4;
    }

    .cc-alert-error {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.2);
      color: #b91c1c;
    }

    .cc-success-pane {
      display: none;
      text-align: center;
      padding: 1rem 0;
    }

    .success-icon-wrap {
      width: 64px;
      height: 64px;
      background: rgba(239, 83, 35, 0.08);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary-orange);
      font-size: 2.25rem;
      margin: 0 auto 1.5rem;
    }

    .cc-success-pane h2 {
      font-size: 1.5rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 0.75rem;
    }

    .cc-success-pane p {
      color: #64748b;
      font-size: 0.98rem;
      line-height: 1.5;
      margin-bottom: 2rem;
    }

    .btn-success-close {
      background: rgba(5, 31, 64, 0.05);
      border: 1px solid var(--border-color);
      color: #64748b;
      padding: 0.75rem 2rem;
      border-radius: 30px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-success-close:hover {
      background: rgba(5, 31, 64, 0.1);
    }

    /* Centers Section */
    .centers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .center-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(5, 31, 64, 0.04);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
    }

    .center-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(5, 31, 64, 0.08);
      border-color: rgba(239, 83, 35, 0.2);
    }

    .center-img-wrapper {
      width: 100%;
      height: 200px;
      overflow: hidden;
      position: relative;
    }

    .center-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .center-card:hover .center-img {
      transform: scale(1.05);
    }

    .center-info {
      padding: 2rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      text-align: left;
    }

    .center-badge-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .center-location-badge {
      background: rgba(239, 83, 35, 0.08);
      color: var(--primary-orange);
      padding: 0.35rem 0.85rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .center-company-name {
      font-size: 1.15rem;
      font-weight: 800;
      color: #051f40;
      margin-bottom: 1rem;
    }

    .center-details-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      font-size: 0.92rem;
      color: #64748b;
    }

    .center-detail-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      line-height: 1.5;
    }

    .center-detail-icon {
      color: var(--primary-orange);
      flex-shrink: 0;
      margin-top: 0.15rem;
      width: 16px;
      height: 16px;
    }

    /* Footer */
    .cc-footer {
      border-top: 1px solid var(--border-color);
      padding: 3.5rem 0;
      text-align: center;
      background: #051f40;
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .cc-footer p {
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body class="crash-course-body">

  <!-- Header -->
  <header class="cc-header">
    <div class="cc-container cc-header-wrap">
      <a href="#" class="cc-logo" style="text-decoration: none;">
        <img src="/Logos/DV-Logo.png" alt="DV Logo" />
      </a>
