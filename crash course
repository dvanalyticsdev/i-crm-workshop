            <label for="studentCountry">Country *</label>
            <select id="studentCountry" required>
              <option value="" disabled selected>Select your country</option>
              <option value="India">India</option>
              <option value="Dubai">Dubai</option>
            </select>
          </div>

          <button type="submit" class="cc-modal-submit-btn" id="submitBtn">Submit Enrollment</button>
        </form>
      </div>

      <!-- Success Panel -->
      <div id="modalSuccessPanel" class="cc-success-pane">
        <div class="success-icon-wrap">✓</div>
        <h2>Registration Successful!</h2>
        <p>Thank you for enrolling in the <strong>7 Days Gen AI &amp; Agentic AI Hands-on Master Program</strong>. Your query has been logged. An admissions coordinator will contact you shortly.</p>
        <button class="btn-success-close" onclick="closeEnrollmentModal()">Back to Page</button>
      </div>
    </div>
  </div>

  <script>
    // Accordion interaction
    function toggleAccordion(dayId) {
      const accordion = document.getElementById(dayId);
      const content = accordion.querySelector('.day-content');
      const isActive = accordion.classList.contains('active');

      // Close all accordions first
      document.querySelectorAll('.day-accordion').forEach(acc => {
        acc.classList.remove('active');
        acc.querySelector('.day-content').style.display = 'none';
      });

      // Toggle clicked
      if (!isActive) {
        accordion.classList.add('active');
        content.style.display = 'block';
      }
    }

    // Modal interaction
    function openEnrollmentModal() {
      document.getElementById('enrollmentModal').classList.add('active');
      document.getElementById('modalFormPanel').style.display = 'block';
      document.getElementById('modalSuccessPanel').style.display = 'none';
      document.getElementById('formErrorAlert').style.display = 'none';
      document.getElementById('enrollmentForm').reset();
    }

    function closeEnrollmentModal() {
      document.getElementById('enrollmentModal').classList.remove('active');
    }

    // Form submission
    async function handleFormSubmit(event) {
      event.preventDefault();
      
      const name = document.getElementById('studentName').value.trim();
      const phone = document.getElementById('studentPhone').value.trim();
      const email = document.getElementById('studentEmail').value.trim();
      const country = document.getElementById('studentCountry').value;
      const courseId = document.getElementById('courseId').value;
      const submitBtn = document.getElementById('submitBtn');
      const errorAlert = document.getElementById('formErrorAlert');

      errorAlert.style.display = 'none';
      
      if (!name || !phone || !email || !country) {
        showError("All fields marked with * are required.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Registering...';

      try {
        const response = await fetch('/api/public-course-registrations', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            courseId,
            name,
            phone,
            email,
            country
          })
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          showError(data?.message || 'Failed to submit registration. Please try again.');
          return;
        }

        // Show Success screen
        document.getElementById('modalFormPanel').style.display = 'none';
        document.getElementById('modalSuccessPanel').style.display = 'block';
      } catch (err) {
        showError('Network error occurred. Please verify your connection.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Enrollment';
      }
    }

    function showError(message) {
      const errorAlert = document.getElementById('formErrorAlert');
      errorAlert.textContent = message;
      errorAlert.style.display = 'block';
    }

    function triggerBrochureDownload() {
      // Mock syllabus pdf trigger using same logic as courses page
      const link = document.createElement("a");
      link.href = "Logos/Brochure.pdf";
      link.download = "7-Days-GenAI-Agentic-Syllabus.pdf";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
</html>
